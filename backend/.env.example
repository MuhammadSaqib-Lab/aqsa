# Copy this file to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------
# PostgreSQL connection string used by the app at runtime.
# Local Postgres: same value as DIRECT_URL below.
# Neon/Supabase: use the POOLED connection string (PgBouncer) they give you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aqsa_physio?schema=public"

# Used only by the Prisma CLI (migrate/studio), never by the running app.
# Local Postgres: same value as DATABASE_URL above.
# Neon/Supabase: use the UNPOOLED/direct connection string — migrations
# must not run through a transaction-mode pooler. See backend/DATABASE.md.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aqsa_physio?schema=public"

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# URL of the deployed frontend, used for CORS — must be the EXACT origin
# (scheme + host, no trailing slash), e.g. https://aqsa-physio.vercel.app.
# Comma-separate multiple origins (e.g. production + a preview URL).
FRONTEND_URL=http://localhost:5173

# --- Auth -------------------------------------------------------------
# Use a long, random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Used only by `npm run prisma:seed` to create the first admin account.
# Not stored anywhere after the seed runs — change the password after first login.
ADMIN_EMAIL=admin@aqsaphysio.com
ADMIN_PASSWORD=change-this-before-seeding

# --- Email (optional) ---------------------------------------------------
# Leave blank to disable email notifications entirely — appointment/contact
# submissions still work and are still saved, emails are just skipped.
# Uses the Resend HTTPS API (https://resend.com), not SMTP — Render blocks/
# restricts outbound SMTP ports, which made a Nodemailer+SMTP transport
# time out (ETIMEDOUT) in production.
RESEND_API_KEY=
EMAIL_FROM="Aqsa Physiotherapy Centre <no-reply@aqsaphysio.com>"
# Where new appointment/contact notifications are sent.
CLINIC_NOTIFICATION_EMAIL=

# --- Clinic hours (used for the availability endpoint) -------------------
# These are placeholders until confirmed by the clinic — see CLAUDE.md.
CLINIC_TIMEZONE=Asia/Karachi
CLINIC_OPEN_TIME=09:00
CLINIC_CLOSE_TIME=20:00
CLINIC_SLOT_MINUTES=30
# Days with fixed hours, 0=Sunday..6=Saturday. Sunday is "by appointment"
# per the clinic's own info, so it's excluded from fixed slot generation.
CLINIC_WORKING_DAYS=1,2,3,4,5,6

# --- API docs -------------------------------------------------------------
# Swagger UI at /api/docs is always on outside production; set to "true" to
# force it on in production too.
ENABLE_API_DOCS=false
