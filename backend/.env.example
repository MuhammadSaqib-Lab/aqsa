# Copy this file to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aqsa_physio?schema=public"

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# URL of the frontend, used for CORS. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173

# --- Auth -------------------------------------------------------------
# Use a long, random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Used only by `npm run prisma:seed` to create the first admin account.
# Not stored anywhere after the seed runs — change the password after first login.
ADMIN_EMAIL=admin@aqsaphysio.com
ADMIN_PASSWORD=change-this-before-seeding

# --- Email (optional) ---------------------------------------------------
# Leave blank to disable email notifications entirely — appointment/contact
# submissions still work and are still saved, emails are just skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Aqsa Physiotherapy Centre <no-reply@aqsaphysio.com>"
# Where new appointment/contact notifications are sent.
CLINIC_NOTIFICATION_EMAIL=

# --- Clinic hours (used for the availability endpoint) -------------------
# These are placeholders until confirmed by the clinic — see CLAUDE.md.
CLINIC_TIMEZONE=Asia/Karachi
CLINIC_OPEN_TIME=09:00
CLINIC_CLOSE_TIME=20:00
CLINIC_SLOT_MINUTES=30
# Days with fixed hours, 0=Sunday..6=Saturday. Sunday is "by appointment"
# per the clinic's own info, so it's excluded from fixed slot generation.
CLINIC_WORKING_DAYS=1,2,3,4,5,6

# --- API docs -------------------------------------------------------------
# Swagger UI at /api/docs is always on outside production; set to "true" to
# force it on in production too.
ENABLE_API_DOCS=false
