generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used only by the Prisma CLI (migrate/studio), never at app runtime.
  // Point this at an unpooled connection when DATABASE_URL is a pooled one
  // (Neon/Supabase PgBouncer) — see backend/DATABASE.md. For a plain local
  // Postgres, both can be the same value.
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum VisitType {
  CLINIC
  HOME
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@map("admin_users")
}

model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  patientId     String?           @db.Uuid
  patient       Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName   String
  phone         String
  email         String?
  preferredDate DateTime          @db.Date
  preferredTime String
  service       String
  message       String?
  status        AppointmentStatus @default(PENDING)
  adminNotes    String?
  visitType     VisitType         @default(CLINIC)
  homeAddress   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([preferredDate])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([preferredDate, preferredTime])
  @@index([patientId])
  @@map("appointments")
}

model Patient {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  appointments Appointment[]
  reviews      Review[]

  @@map("patients")
}

model ContactMessage {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  email     String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("contact_messages")
}

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  patientId   String?      @db.Uuid
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName String
  rating      Int
  reviewText  String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([patientId])
  @@map("reviews")
}
